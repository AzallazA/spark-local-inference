+def _gather_pull_enabled(world_size: int) -> bool:
+    """Select the pull data plane for the generic (non-TP2) head gather.
+
+    TP3 patch (ds41-tp3, 2026-11-09). On the Threadripper PRO 7965WX host, with
+    three GPUs on separate root ports (``nvidia-smi topo`` NODE), SM-issued
+    posted writes to a peer run at about 2.6 GB/s per GPU in aggregate, while
+    SM-issued peer reads reach about 40 GB/s (world-3 one-shot pull all-reduce
+    and LSE reduce-scatter). Pull stages the local segment into this rank's own
+    staging, crosses the same per-CTA barrier, and reads the peers' staging.
+    ``B12X_PCIE_DCP_GATHER_PULL``: ``auto`` (default, pull at world 3 only),
+    ``1`` (pull at every world, world 2 included: TP2 patch 2026-11-10, the
+    generic pull plane with one peer; small payloads keep the TP2 push),
+    ``0`` (always push, upstream).
+    """
+    mode = os.environ.get("B12X_PCIE_DCP_GATHER_PULL", "auto").strip().lower()
+    if mode in ("0", "off", "push", "false"):
+        return False
+    if mode in ("1", "on", "pull", "true"):
+        return True
+    return int(world_size) == 3
+
+
+def _gather_pull_min_bytes() -> int:
+    """Per-rank payload (bytes) from which the pull plane is used; smaller stays push.
+
+    Crossover from the 2026-11-09 TP3 measurements: push ~1.5 us + 2P/2.6 GB/s,
+    pull ~5-7 us + 2P/42 GB/s, equal near P = 4-5 KiB. ``0`` always pulls.
+    """
+    return max(0, int(os.environ.get("B12X_PCIE_DCP_GATHER_PULL_MIN_BYTES", "4096")))
+
