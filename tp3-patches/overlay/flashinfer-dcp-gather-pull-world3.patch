+    @cute.jit
+    def _gather_pull_generic(
+        self,
+        local_input,
+        output,
+        staging,
+        signals,
+        batch,
+        local_packs,
+        tiles_per_rank,
+        lane,
+        warp_first,
+        warp_stride,
+        tidx,
+    ):
+        # Pull data plane (TP3 patch). Phase one copies this rank's segment
+        # into its OWN staging (local writes) and its own output columns.
+        # Phase two reads every peer's staging (PCIe reads, which this
+        # fabric serves ~15x faster than SM posted writes) into the output.
+        # Both phases walk the same tile -> warp map, so after the per-CTA
+        # pair barrier CTA b only reads segments that peer CTA b staged.
+        # Reuse of a staging slot two calls later is ordered exactly as in
+        # the world-3 LSE reduce-scatter pull path (stream order plus the
+        # intervening call's barrier).
+        own_stage = self._staging_words(staging[self._rank])
+        tiles = batch * tiles_per_rank
+        tile = warp_first
+        while tile < tiles:
+            batch_index = tile // tiles_per_rank
+            pack = (tile - batch_index * tiles_per_rank) * Int32(32) + lane
+            if pack < local_packs:
+                source_pack = Int64(batch_index) * Int64(local_packs) + Int64(pack)
+                output_pack = (
+                    Int64(batch_index) * Int64(self._world_size)
+                    + Int64(self._rank)
+                ) * Int64(local_packs) + Int64(pack)
+                values = ld_global_v4_u32(
+                    (local_input + source_pack * Int64(4)).toint()
+                )
+                st_global_v4_u32((own_stage + source_pack * Int64(4)).toint(), *values)
+                st_global_v4_u32((output + output_pack * Int64(4)).toint(), *values)
+            tile += warp_stride
+
+        block_pair_barrier(
+            signals,
+            self_signal=signals[self._rank],
+            rank=self._rank,
+            world_size=self._world_size,
+            max_blocks=_MAX_BLOCKS,
+        )
+        # Acquire the peers' staged segments before reading them remotely.
+        if Int32(tidx) == Int32(0):
+            _membar_sys()
+        cute.arch.sync_threads()
+
+        tile = warp_first
+        while tile < tiles:
+            batch_index = tile // tiles_per_rank
+            pack = (tile - batch_index * tiles_per_rank) * Int32(32) + lane
+            if pack < local_packs:
+                source_pack = Int64(batch_index) * Int64(local_packs) + Int64(pack)
+                # Issue every peer's 16-byte load before any store so each
+                # lane keeps world-1 PCIe reads in flight.
+                fetched = []
