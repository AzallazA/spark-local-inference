+    @cute.jit
+    def _gather_push_generic(
+        self,
+        local_input,
+        output,
+        staging,
+        signals,
+        batch,
+        local_packs,
+        tiles_per_rank,
+        lane,
+        warp_first,
+        warp_stride,
+        tidx,
